
# ==========================================
# Attendify - Git Ignore
# ==========================================

# Old Git history backup
.git_old_backup/

# Secrets and local environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python virtual environments
venv/
.venv/
**/venv/
**/.venv/

# Python cache and generated files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node.js dependencies
node_modules/
**/node_modules/

# Frontend build output
frontend/dist/
frontend/build/
dist/
build/

# Local databases
*.db
*.sqlite
*.sqlite3

# Runtime logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Personal biometric data and face recognition files
backend/face_uploads/
backend/session_captures/
backend/session_photos/
backend/face_model/gallery.npz
backend/face_model/labels.json

# Model weights and generated model files
*.pt
*.pth
*.onnx
*.h5
*.keras
*.tflite

# Uploaded files and generated reports
uploads/
outputs/
reports/
*.xlsx
*.xls

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak

# Package and test artifacts
.pytest_cache/
.nyc_output/
coverage/
